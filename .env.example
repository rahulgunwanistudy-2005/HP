# Local setup: Node 24.15+ within 24.x; loopback by default.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=storage/intelligence.sqlite
# Required (32+ random characters) if HOST is not loopback.
# Keep private. This is also the hosted workspace sign-in key.
# API_TOKEN=
AI_PROVIDER=none
RESEARCH_ENABLED=true
# Exact trusted frontend origin for writes through the Vercel relay.
# CLIENT_ORIGINS=https://your-project.vercel.app
# Vercel server-only variable; set in Vercel, never prefix with VITE_.
# RENDER_API_URL=https://your-service.onrender.com
# Render variables and disk settings are specified in render.yaml.
