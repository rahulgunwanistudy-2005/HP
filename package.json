{
  "name": "hp-account-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:api": "node --watch --import tsx server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "research": "node --import tsx scripts/research.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "export:briefs": "node --import tsx scripts/export-briefs.ts",
    "start:hosted": "node --import tsx scripts/start-hosted.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.3.0",
    "libsql": "0.5.29",
    "lucide-react": "^0.468.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
